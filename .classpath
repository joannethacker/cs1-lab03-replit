<?xml version="1.0" encoding="UTF-8"?>
<classpath>
    <!-- Instructs the editor to trace local source roots -->
    <classpathentry kind="src" path=""/>
    
    <!-- Hooks up structural core Java definitions -->
    <classpathentry kind="con" path="org.eclipse.jdt.launching.JRE_CONTAINER"/>
    
    <!-- References the absolute home address of the jar file -->
    <classpathentry kind="lib" path="/home/runner/workspace/cardgames.jar"/>
    
    <classpathentry kind="output" path=""/>
</classpath>
